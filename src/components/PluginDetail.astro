---
/**
 * Ürün tanıtım sayfası (ADR-024) — iki dilli (ADR-023).
 *
 * Bu sayfa teknik döküm değil, **satış metnidir**: önce kimliğe/duyguya
 * dokunan başlık, sonra somut kanıt (elle kaç dakika / bu araçla kaç saniye),
 * sonra üç anlatı bölümü. En altta gösterişli buton ziyaretçiyi ürünün
 * mağazadaki kendi sayfasına götürür.
 *
 * **Fiyat burada yok.** Güncel sürüm, fiyat ve satın alma mağazada durur;
 * iki yerde fiyat tutmak ikisinin de bayatlamasına yol açıyordu.
 */
import Base from "../layouts/Base.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import LangSwitch from "./LangSwitch.astro";
import { ikon, type Product } from "../lib/products";
import { METIN, LISTE_YOLU, urunYolu, urunDilde, type Dil } from "../lib/i18n";
import { getSoftwareIndex } from "../lib/discover";
import { formatDate } from "../lib/content";

interface Props {
  product: Product;
  dil: Dil;
}

const { product, dil } = Astro.props;
const t = METIN[dil];
const u = urunDilde(product.data, dil);
const site = Astro.site ?? new URL("https://www.ufuksen.com");

/** İlgili yazılar — arşivden gerçek içerik, uydurma değil. */
const softwareIndex = await getSoftwareIndex();
const ilgiliYazilar = u.yazilim.length
  ? (softwareIndex.find((entry) => entry.tag.slug === u.yazilim[0])?.posts ?? []).slice(0, 4)
  : [];
const yazilimSlug = u.yazilim[0] ?? null;
const yazilimAdi =
  softwareIndex.find((entry) => entry.tag.slug === yazilimSlug)?.tag.name ?? null;

/**
 * Meta açıklaması: kanca cümlesi + tanıtımın başı, 155 karaktere kırpılır.
 *
 * Yalnızca `ozet` kullanılsaydı 70 karakterin altında kalıyordu (ölçüldü: 54
 * sayfa). Google kısa açıklamayı kendi uydurduğu bir parçayla değiştirir;
 * uzun kuyruklu ifadeyi oraya koymak bizim elimizde.
 */
function metaAciklama(): string {
  const tam = [u.baslik, u.sunum ?? u.ozet].filter(Boolean).join(" ");
  if (tam.length <= 155) return tam;
  const kirpik = tam.slice(0, 155);
  const son = kirpik.lastIndexOf(" ");
  return `${kirpik.slice(0, son > 100 ? son : 155).trim()}…`;
}

/** Kazanılan zamanı kaç kat olduğuyla göstermek rakamı somutlaştırır. */
const kat =
  u.kanit && u.kanit.sonrakiSaniye > 0
    ? Math.round((u.kanit.oncekiDakika * 60) / u.kanit.sonrakiSaniye)
    : null;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: u.ad,
  description: u.ozet,
  applicationCategory: "DesignApplication",
  url: new URL(urunYolu(u.slug, dil), site).href,
  author: { "@type": "Person", name: "Ufuk Şen", url: site.href },
  ...(u.surum ? { softwareVersion: u.surum } : {}),
  ...(u.uyumluluk.length ? { operatingSystem: u.uyumluluk.join(", ") } : {}),
  ...(u.vurgular.length ? { featureList: u.vurgular } : {}),
  ...(u.magazaUrl ? { sameAs: u.magazaUrl } : {}),
};
---

<Base
  title={`${u.ad} — ${t.turTekil[u.tur]} | Ufuk Şen`}
  description={metaAciklama()}
  path={urunYolu(u.slug, dil)}
  dil={dil}
  alternateUrl={urunYolu(u.slug, dil === "tr" ? "en" : "tr")}
  padded={false}
  jsonLd={jsonLd}
>
  <article class="p">
    {/* ---------------- Başlık: kimlik / duygu ---------------- */}
    <header class="p__head">
      <nav class="p__crumb" aria-label="Konum">
        <a href={LISTE_YOLU[dil]}>{t.bolumKisa}</a>
        <span aria-hidden="true">/</span>
        <b>{u.ad}</b>
        <LangSwitch dil={dil} yol={urunYolu(u.slug, dil)} />
      </nav>

      <p class="p__kind">
        {t.turTekil[u.tur]}
        {u.surum && <span> · v{u.surum}</span>}
      </p>
      <h1>{u.ad}</h1>

      {u.baslik && <p class="p__hook">{u.baslik}</p>}
      {u.sunum && <p class="p__lead">{u.sunum}</p>}
    </header>

    <div class="p__body">
      {/* ---------------- Somut kanıt: elle vs. araçla ---------------- */}
      {
        u.kanit && (
          <section class="proof u-reveal" aria-label={t.kanitBaslik}>
            <h2>{t.kanitBaslik}</h2>
            <div class="proof__grid">
              <div class="proof__cell proof__cell--once">
                <span class="proof__etiket">{t.kanitElle}</span>
                <b>
                  {u.kanit.oncekiDakika}
                  <i>{t.kanitDakika}</i>
                </b>
                <p>{u.kanit.oncekiEtiket}</p>
              </div>
              <div class="proof__ok" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M4 12h15M13 6l6 6-6 6" />
                </svg>
                {kat && <span>{kat}×</span>}
              </div>
              <div class="proof__cell proof__cell--sonra">
                <span class="proof__etiket">{t.kanitEklentiyle}</span>
                <b>
                  {u.kanit.sonrakiSaniye}
                  <i>{t.kanitSaniye}</i>
                </b>
                <p>{u.kanit.sonrakiEtiket}</p>
              </div>
            </div>
          </section>
        )
      }

      {/* ---------------- Anlatı bölümleri ---------------- */}
      {
        u.hikayeler.map((h) => (
          <section class="story u-reveal">
            <h2>{h.baslik}</h2>
            <p>{h.metin}</p>
          </section>
        ))
      }

      {/* ---------------- Öne çıkanlar ---------------- */}
      {
        u.vurgular.length > 0 && (
          <section class="u-reveal">
            <h2>{t.ozellikler}</h2>
            <ul class="feats">
              {u.vurgular.map((v, i) => (
                <li>
                  <span class="feats__icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      set:html={ikon(u.ozellikler[i]?.ikon)}
                    />
                  </span>
                  <b>{v}</b>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        u.uyumluluk.length > 0 && (
          <section class="u-reveal">
            <h2>{t.uyumluluk}</h2>
            <ul class="compat">
              {u.uyumluluk.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      {/* ---------------- Gösterişli buton: ürünün mağaza sayfası ---------------- */}
      {
        u.magazaUrl && (
          <section class="cta u-reveal">
            <span class="cta__rozet">{t.magazaRozet}</span>
            <a class="cta__btn" href={u.magazaUrl} target="_blank" rel="noopener">
              <span>{t.magazaCta(u.ad)}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" />
              </svg>
            </a>
            <p class="cta__not">{t.magazaNot}</p>
          </section>
        )
      }

      {
        ilgiliYazilar.length > 0 && (
          <section class="u-reveal">
            <h2>{t.ilgiliYazilar(yazilimAdi ?? "")}</h2>
            <p class="note">{t.arsivNotu}</p>
            <ul class="rel">
              {ilgiliYazilar.map((post) => (
                <li>
                  <a href={post.data.url}>
                    <b>{post.data.title}</b>
                    <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
                  </a>
                </li>
              ))}
            </ul>
            {yazilimSlug && (
              <a class="rel__all" href={`/yazilim/${yazilimSlug}`}>
                {t.tumYazilar(yazilimAdi ?? "")}
              </a>
            )}
          </section>
        )
      }
    </div>

    <footer class="p__foot">
      <div>
        <h2>{t.sorunuzMuVar}</h2>
        <p>{t.sorunuzMuVarNot}</p>
      </div>
      <WhatsAppButton konu={u.ad} boyut="buyuk" etiket={t.waSor} dil={dil} />
    </footer>
  </article>
</Base>

<style>
  /* ---------------- Başlık ---------------- */

  .p__head {
    padding: var(--s-8) var(--s-6);
    border-bottom: 1px solid var(--c-line-strong);
    background-color: var(--c-surface);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      radial-gradient(80% 80% at 12% 0%, rgb(255 212 0 / 0.09), transparent 62%);
    background-size:
      28px 28px,
      28px 28px,
      100% 100%;
  }

  .p__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
    margin-bottom: var(--s-6);
  }
  .p__crumb a {
    color: var(--c-text-muted);
    text-decoration: none;
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    padding-right: var(--s-1);
  }
  .p__crumb a:hover,
  .p__crumb a:focus-visible {
    color: var(--c-accent);
  }
  .p__crumb b {
    color: var(--c-text);
    font-weight: 500;
  }
  .p__crumb :global(.lang) {
    margin-left: auto;
  }

  .p__kind {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-accent);
    max-width: none;
  }

  .p__head h1 {
    font-size: clamp(1.9rem, 6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-top: var(--s-2);
  }

  /* Kancayı taşıyan cümle — sayfanın en çok okunan satırı */
  .p__hook {
    margin-top: var(--s-4);
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.5rem);
    line-height: 1.35;
    color: var(--c-accent);
    font-weight: 600;
    max-width: 30ch;
  }
  .p__lead {
    margin-top: var(--s-4);
    font-size: var(--t-body-lg);
    color: var(--c-text-muted);
    max-width: 62ch;
  }

  /* ---------------- Gövde ---------------- */

  .p__body {
    padding: var(--s-8) var(--s-6);
    display: grid;
    gap: var(--s-8);
  }
  .p__body h2 {
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
    margin-bottom: var(--s-4);
  }
  .note {
    color: var(--c-text-faint);
    font-size: var(--t-micro);
    margin-top: var(--s-3);
    max-width: none;
  }

  /* ---------------- Kanıt: elle vs. araçla ---------------- */

  .proof__grid {
    display: grid;
    gap: var(--s-4);
    align-items: center;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    background: var(--c-surface);
  }
  .proof__cell {
    display: grid;
    gap: var(--s-1);
  }
  .proof__etiket {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-text-faint);
  }
  .proof__cell b {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .proof__cell b i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    font-weight: 400;
    letter-spacing: 0;
  }
  .proof__cell p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    max-width: 34ch;
  }
  /* Eski hâl soluk, yeni hâl sarı: fark bir bakışta okunur */
  .proof__cell--once b {
    color: var(--c-text-faint);
  }
  .proof__cell--sonra b {
    color: var(--c-accent);
  }

  .proof__ok {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--t-body-lg);
  }
  .proof__ok svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 720px) {
    .proof__grid {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--s-6);
    }
  }

  /* ---------------- Anlatı ---------------- */

  .story {
    border-left: 2px solid var(--c-accent-dim);
    padding-left: var(--s-6);
  }
  .story h2 {
    margin-bottom: var(--s-3);
  }
  .story p {
    color: var(--c-text-muted);
    font-size: var(--t-body);
    max-width: 68ch;
  }

  /* ---------------- Öne çıkanlar ---------------- */

  .feats {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }
  .feats li {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface-raised);
  }
  .feats__icon {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    background: var(--c-accent-wash);
    color: var(--c-accent);
  }
  .feats__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .feats b {
    color: var(--c-text);
    font-weight: 600;
    font-size: var(--t-body);
  }
  @media (min-width: 700px) {
    .feats {
      grid-template-columns: repeat(3, 1fr);
    }
    .feats li {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);
    }
  }

  .compat {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .compat li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }

  /* ---------------- Gösterişli buton ---------------- */

  .cta {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
    padding: var(--s-12) var(--s-6);
    border: 1px solid var(--c-accent-dim);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 140% at 50% 0%, rgb(255 212 0 / 0.14), transparent 62%),
      var(--c-surface);
  }
  .cta__rozet {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-text-faint);
  }
  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 64px;
    padding: 0 var(--s-8);
    border-radius: var(--r-pill);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 10px 40px rgb(255 212 0 / 0.22);
    transition:
      transform var(--d-base) var(--e-out),
      box-shadow var(--d-base) var(--e-out),
      filter var(--d-fast) var(--e-out);
  }
  .cta__btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--d-base) var(--e-out);
  }
  .cta__btn:hover,
  .cta__btn:focus-visible {
    filter: brightness(1.06);
    transform: translateY(-2px);
    box-shadow: 0 16px 54px rgb(255 212 0 / 0.3);
  }
  .cta__btn:hover svg {
    transform: translateX(4px);
  }
  .cta__not {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    max-width: 44ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__btn,
    .cta__btn svg {
      transition: none;
    }
    .cta__btn:hover {
      transform: none;
    }
    .cta__btn:hover svg {
      transform: none;
    }
  }

  /* ---------------- İlgili yazılar ---------------- */

  .rel {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .rel a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    min-height: var(--tap-min);
    background: var(--c-surface-raised);
    text-decoration: none;
    color: var(--c-text-muted);
  }
  .rel b {
    color: var(--c-text);
    font-weight: 500;
    font-size: var(--t-small);
  }
  .rel time {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
  }
  .rel a:hover,
  .rel a:focus-visible {
    background: var(--c-surface-hover);
  }
  .rel a:hover b,
  .rel a:focus-visible b {
    color: var(--c-accent);
  }
  .rel__all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: var(--s-3);
    color: var(--c-accent);
    font-size: var(--t-small);
    text-decoration: none;
  }
  .rel__all:hover,
  .rel__all:focus-visible {
    text-decoration: underline;
  }

  /* ---------------- Alt ---------------- */

  .p__foot {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-8) var(--s-6);
    border-top: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    align-items: center;
  }
  .p__foot h2 {
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
  }
  .p__foot p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-top: var(--s-2);
  }

  @media (min-width: 760px) {
    .p__head,
    .p__body,
    .p__foot {
      padding-left: var(--s-8);
      padding-right: var(--s-8);
    }
    .p__foot {
      grid-template-columns: 1fr auto;
    }
  }
</style>
