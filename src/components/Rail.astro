---
/**
 * Sol sabit ikon şeridi (ADR-016).
 *
 * Masaüstünde sayfanın solunda sabit durur. Mobilde alt kenara yapışan bir
 * çubuğa dönüşür — hamburger menüye gerek kalmaz, çünkü öğe sayısı az ve
 * her biri 44px dokunma hedefini karşılar.
 *
 * İkonlar satır içi SVG: ek istek yok, renk `currentColor` ile temadan gelir.
 */
import SocialLinks from "./SocialLinks.astro";

const path = Astro.url.pathname;

const items = [
  { href: "/", label: "Profil", icon: "user" },
  { href: "/blog", label: "Blog", icon: "book" },
  { href: "/urunler", label: "Ürünler", icon: "box" },
  { href: "/egitimler", label: "Eğitim", icon: "cap" },
  { href: "/videolar", label: "Video", icon: "play" },
  { href: "/yazilim", label: "Yazılım", icon: "layers" },
  { href: "/arama", label: "Ara", icon: "search" },
  { href: "/iletisim", label: "İletişim", icon: "mail" },
] as const;

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

const icons: Record<string, string> = {
  user: '<circle cx="12" cy="8" r="3.4"/><path d="M4.8 20c0-3.6 3.2-5.6 7.2-5.6s7.2 2 7.2 5.6"/>',
  book: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M8 9h8M8 13h5"/>',
  box: '<path d="M12 3 4.5 7v10L12 21l7.5-4V7z"/><path d="M4.5 7 12 11l7.5-4M12 11v10"/>',
  cap: '<path d="m12 4 9 4.5-9 4.5-9-4.5z"/><path d="M7 10.5V16c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-5.5"/>',
  play: '<rect x="3" y="5.5" width="18" height="13" rx="3"/><path d="m10.5 9.5 5 2.5-5 2.5z"/>',
  layers: '<path d="m12 3 8 4.5-8 4.5-8-4.5z"/><path d="m4 12 8 4.5 8-4.5M4 16.5 12 21l8-4.5"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="M15.5 15.5 20 20"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
};
---

<nav class="rail" aria-label="Ana menü">
  <a class="rail__brand" href="/" aria-label="Ana sayfa — Ufuk Şen">
    <img src="/media/marka/ufuksenlogo.png" alt="Ufuk Şen" width="260" height="98" />
  </a>
  <ul class="rail__list">
    {
      items.map((item) => (
        <li>
          <a
            class="rail__item"
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[item.icon]} />
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="rail__social">
    <SocialLinks variant="rail" />
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    z-index: var(--z-nav);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    display: flex;
    /* Mobil: alt çubuk */
    inset: auto 0 0 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    gap: var(--s-1);
    padding: var(--s-2) var(--s-2) calc(var(--s-2) + env(safe-area-inset-bottom, 0px));
    border-radius: var(--r-xl) var(--r-xl) 0 0;
    border-bottom: 0;
  }

  .rail__brand {
    display: none;
  }

  /* Mobilde şerit alt sekme çubuğudur; sosyal ikonlar orayı kalabalıklaştırır.
     Mobilde footer'daki sıra devrede kalır. */
  .rail__social {
    display: none;
  }

  .rail__list {
    display: flex;
    flex-direction: row;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    justify-content: space-around;
  }

  .rail__item {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 4px;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: var(--s-2);
    border-radius: var(--r-md);
    color: var(--c-text-muted);
    text-decoration: none;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    transition: color var(--d-fast) var(--e-out), background var(--d-fast) var(--e-out);
  }

  .rail__item svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rail__item:hover,
  .rail__item:focus-visible {
    color: var(--c-text);
    background: var(--c-surface-hover);
  }

  /* Aktif öğe: sarı vurgu (ADR-015 — sarı artık vurgu rolünde) */
  .rail__item[aria-current="page"] {
    color: var(--c-accent);
    background: var(--c-accent-wash);
  }

  /* ---- Masaüstü: sol dikey şerit ------------------------------------ */
  @media (min-width: 1024px) {
    .rail {
      inset: var(--s-6) auto var(--s-6) var(--s-6);
      flex-direction: column;
      justify-content: flex-start;
      width: var(--rail-w);
      padding: var(--s-3);
      border-radius: var(--r-xl);
      border-bottom: 1px solid var(--c-line);
      gap: var(--s-3);
      /* Kısa ekranlarda (1366x768 laptop ~700px kullanılabilir yükseklik)
         menü + sosyal ikonlar şeride sığmıyor ve ekran dışında kalıyordu.
         İçeriden kaydırılabilir yapıldı; hiçbir öğe ulaşılamaz olmuyor. */
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--c-line-strong) transparent;
    }
    .rail::-webkit-scrollbar {
      width: 4px;
    }
    .rail::-webkit-scrollbar-thumb {
      background: var(--c-line-strong);
      border-radius: var(--r-pill);
    }

    /* Logo şeffaf arka planlı (RGBA) ve açık renkli — koyu yüzeyde durur.
       Sarı zemine konsaydı kırmızı play işaretiyle çakışırdı. */
    .rail__brand {
      display: grid;
      place-items: center;
      width: 100%;
      min-height: 52px;
      padding: var(--s-2);
      border-radius: var(--r-lg);
      background: var(--c-base);
      border: 1px solid var(--c-line);
      text-decoration: none;
      transition: border-color var(--d-fast) var(--e-out);
    }
    .rail__brand img {
      width: 100%;
      height: auto;
      max-width: 60px;
    }
    .rail__brand:hover,
    .rail__brand:focus-visible {
      border-color: var(--c-accent);
    }

    .rail__list {
      flex-direction: column;
      width: 100%;
      gap: var(--s-1);
      justify-content: flex-start;
    }

    .rail__item {
      width: 100%;
      padding-block: var(--s-3);
    }

    .rail__social {
      display: block;
      width: 100%;
      margin-top: auto;
      padding-top: var(--s-3);
      border-top: 1px solid var(--c-line);
    }
  }

  /**
   * Kısa masaüstü ekranlar (1366×768 gibi yaygın laptoplarda kullanılabilir
   * yükseklik ~700px). Ölçüldü: menü + sosyal ikonlar 778px yer istiyordu,
   * şeritte 632px vardı — sosyal ikonlar ekran dışında kalıyordu.
   * Kaydırma çözüm değil; kullanıcı dar bir şeritte kaydırma olduğunu fark
   * etmez. Bu yüzden düzen sıkıştırılıyor: etiketler küçülüyor, dolgular
   * azalıyor ve sosyal ikonlar tek sütun yerine 2×2 yerleşiyor.
   */
  @media (min-width: 1024px) and (max-height: 820px) {
    .rail {
      gap: var(--s-2);
      padding: var(--s-2);
    }
    .rail__brand {
      min-height: 42px;
    }
    .rail__item {
      padding-block: var(--s-2);
      font-size: 0.625rem;
      gap: 2px;
    }
    .rail__item svg {
      width: 19px;
      height: 19px;
    }
    .rail__social :global(.social--rail) {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px;
    }
    .rail__social :global(.social--rail a) {
      width: calc(50% - 2px);
      height: 32px;
    }
  }
</style>
