---
import SocialLinks from "./SocialLinks.astro";
import { SAYFA } from "../lib/i18n-sayfalar";
import { LISTE_YOLU, METIN, type Dil } from "../lib/i18n";

interface Props {
  dil?: Dil;
}

const { dil = "tr" } = Astro.props;
const m = SAYFA[dil].menu;
const en = dil === "en";
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot__top">
    <a class="foot__brand" href={en ? "/en/" : "/"} aria-label="Ana sayfa — Ufuk Şen">
      <img src="/media/marka/ufuksenlogo.png" alt="Ufuk Şen" width="260" height="98" />
    </a>
    <SocialLinks variant="row" size="sm" />
  </div>
  <div class="foot__bottom">
    <span>© {year} Ufuk Şen</span>
    <div class="foot__links">
      <a href={en ? "/en/blog" : "/blog"}>{m.blog}</a>
      <a href={LISTE_YOLU[dil]}>{METIN[dil].bolumAdi}</a>
      <a href={en ? "/en/courses" : "/egitimler"}>{m.egitim}</a>
      {/* Yorum sayfasının İngilizcesi yok; olmayan sayfaya bağlantı basmıyoruz. */}
      {!en && <a href="/ne-demisler">Ne Demişler?</a>}
      <a href={en ? "/en/videos" : "/videolar"}>{m.video}</a>
      <a href={en ? "/en/software" : "/yazilim"}>{m.yazilim}</a>
      <a href={en ? "/en/search" : "/arama"}>{m.ara}</a>
      <a href={en ? "/en/contact" : "/iletisim"}>{m.iletisim}</a>
      <a href="/rss.xml">{SAYFA[dil].footerRss}</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-8);
  }
  .foot__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--c-line);
  }
  .foot__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .foot__brand img {
    width: 130px;
    height: auto;
    opacity: 0.85;
    transition: opacity var(--d-fast) var(--e-out);
  }
  .foot__brand:hover img,
  .foot__brand:focus-visible img {
    opacity: 1;
  }
  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: space-between;
    align-items: center;
    font-size: var(--t-small);
    color: var(--c-text-faint);
  }
</style>
