---
/**
 * Dil düğmesi (ADR-023, ADR-025).
 *
 * Bulunduğu sayfanın diğer dildeki karşılığını `karsiYol` ile bulur.
 * **Karşılığı yoksa hiç render edilmez** — çalışmayan ya da 404'e giden bir
 * düğme göstermeyiz (AGENTS.md §5).
 *
 * Yurt dışından gelen ziyaretçi Cloudflare tarafında İngilizceye yönlendirilir
 * (worker/index.js); bu düğme o kararı elle değiştirmek içindir ve seçim
 * çerezde saklanır, sonraki ziyarette yönlendirme tekrar araya girmez.
 */
import { METIN, digerDil, type Dil } from "../lib/i18n";
import { karsiYol } from "../lib/i18n-sayfalar";

interface Props {
  dil: Dil;
  /** Bulunulan yol; verilmezse Astro'nun geçerli adresi kullanılır. */
  yol?: string;
  class?: string;
}

const { dil, yol = Astro.url.pathname, class: className = "" } = Astro.props;

const hedefDil = digerDil(dil);
const t = METIN[dil];
const href = karsiYol(yol, hedefDil);
---

{
  href && (
    <a
      class:list={["lang", className]}
      href={href}
      title={t.digerDilBaslik}
      data-lang-switch={hedefDil}
      hreflang={hedefDil}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17" />
      </svg>
      <span>{t.digerDilEtiketi}</span>
    </a>
  )
}

<script>
  /**
   * Kullanıcı dili elle seçtiyse konum tabanlı yönlendirme bir daha araya
   * girmesin: seçim bir yıl boyunca çerezde saklanır, worker onu okur.
   */
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((a) => {
      a.addEventListener("click", () => {
        document.cookie = `dil=${a.dataset.langSwitch}; path=/; max-age=31536000; samesite=lax`;
      });
    });
  });
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 36px;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      border-color var(--d-fast) var(--e-out),
      color var(--d-fast) var(--e-out);
  }
  .lang svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .lang:hover,
  .lang:focus-visible {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /**
   * Şeritte: 56px genişlikte küre ikonu + metin tek satıra sığmıyordu
   * (ölçüldü: metin alt satıra kayıyordu). Dar şeritte ikon düşürülür,
   * iki harflik dil kodu tek başına zaten anlaşılır.
   */
  .lang--rail {
    width: 100%;
    min-height: var(--tap-min);
    padding: 0;
    gap: 0;
  }
  .lang--rail svg {
    display: none;
  }
  .lang--rail span {
    font-weight: 600;
    letter-spacing: 0.12em;
  }
</style>
