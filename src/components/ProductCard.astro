---
/**
 * Ürün kartı — teknik çizim paftası biçiminde (ADR-021).
 *
 * Tasarım dili SketchUp'ın kendi görsel diline dayanır: kareli zemin ızgarası,
 * kırmızı/yeşil/mavi eksen işareti, ölçü çizgisi ve çizim paftalarının sağ alt
 * köşesindeki künye bloğu. Amaç, sayfayı Instagram'dan açan birinin iki
 * saniyede "bu bir SketchUp aracı" diyebilmesi.
 *
 * Veriler `src/content/products.json` içinde. Boş alanlar render edilmez —
 * eksik bilgi yer tutucu metinle doldurulmaz (AGENTS.md §5).
 */
import WhatsAppButton from "./WhatsAppButton.astro";

export interface Product {
  slug: string;
  ad: string;
  tur: "eklenti" | "arac" | "sablon";
  durum: "aktif" | "beta" | "alfa" | "gelistiriliyor" | "arsiv";
  ilerleme?: number;
  surum: string | null;
  ozet: string;
  aciklama: string | null;
  slogan: string | null;
  gorsel: string | null;
  gorselAlt: string | null;
  uyumluluk: string[];
  ozellikler: { baslik: string; not: string; ikon: string }[];
  desenler: string[];
  desenNotu: string | null;
  vurgular: string[];
  iletisimEposta: string | null;
  satinAlmaUrl: string | null;
  yazilim: string[];
}

interface Props {
  product: Product;
  /** Kartın listedeki sırası — künyedeki pafta numarası için. */
  index?: number;
}

const { product, index = 0 } = Astro.props;

const DURUM: Record<Product["durum"], { etiket: string; ton: string }> = {
  aktif: { etiket: "Yayında", ton: "ok" },
  beta: { etiket: "Beta", ton: "warn" },
  alfa: { etiket: "Alfa", ton: "warn" },
  gelistiriliyor: { etiket: "Geliştiriliyor", ton: "warn" },
  arsiv: { etiket: "Arşiv", ton: "muted" },
};

const TUR: Record<Product["tur"], string> = {
  eklenti: "SketchUp eklentisi",
  arac: "Web aracı",
  sablon: "Şablon",
};

const durum = DURUM[product.durum];
const href = `/urunler/${product.slug}`;

/** Künyedeki pafta numarası — çizim sayfalarındaki "SHEET 01/03" karşılığı. */
const paftaNo = String(index + 1).padStart(2, "0");
---

<article class="pcard">
  <div class="pcard__sheet">
    {/* SketchUp eksen işareti: kırmızı X, yeşil Y, mavi Z */}
    <svg class="pcard__axis" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <path d="M8 32h22" stroke="#e5484d" />
      <path d="M8 32 24 22" stroke="#46a758" />
      <path d="M8 32V10" stroke="#3b82f6" />
      <circle cx="8" cy="32" r="1.8" fill="currentColor" stroke="none" />
    </svg>

    <p class="pcard__kind">{TUR[product.tur]}</p>

    <h3 class="pcard__title">
      <a href={href}>{product.ad}</a>
    </h3>

    {/* Ölçü çizgisi — teknik çizimlerdeki kotalama oku */}
    <div class="pcard__dim" aria-hidden="true">
      <span class="pcard__dim-line"></span>
      <span class="pcard__dim-text">
        {product.surum ? `v${product.surum}` : durum.etiket}
      </span>
      <span class="pcard__dim-line"></span>
    </div>

    <p class="pcard__lead">{product.ozet}</p>

    {
      product.vurgular.length > 0 && (
        <ul class="pcard__points">
          {product.vurgular.slice(0, 3).map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>

  {/* Künye bloğu — teknik çizimin sağ alt köşesindeki bilgi tablosu */}
  <dl class="pcard__block">
    <div>
      <dt>Durum</dt>
      <dd class:list={[`is-${durum.ton}`]}>
        {durum.etiket}{product.ilerleme ? ` %${product.ilerleme}` : ""}
      </dd>
    </div>
    <div>
      <dt>Uyumluluk</dt>
      <dd>{product.uyumluluk.length ? product.uyumluluk.join(" · ") : "—"}</dd>
    </div>
    <div>
      <dt>Pafta</dt>
      <dd>{paftaNo}</dd>
    </div>
  </dl>

  <div class="pcard__cta">
    <a class="pcard__more" href={href}>
      İncele
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" />
      </svg>
    </a>
    <WhatsAppButton konu={product.ad} etiket="Sor" />
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto auto;
    background: var(--c-surface-raised);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition:
      border-color var(--d-base) var(--e-out),
      transform var(--d-base) var(--e-out);
  }

  /* Çizim paftası zemini: ince kareli ızgara + koyu köşe vinyeti */
  .pcard__sheet {
    position: relative;
    padding: var(--s-6);
    display: grid;
    gap: var(--s-3);
    align-content: start;
    background-color: var(--c-surface);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .pcard__sheet::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 0%, transparent 45%, rgb(0 0 0 / 0.28));
  }

  .pcard__axis {
    width: 34px;
    height: 34px;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    color: var(--c-text-faint);
    opacity: 0.85;
  }

  .pcard__kind {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-text-faint);
    max-width: none;
  }

  .pcard__title {
    font-size: var(--t-h2);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }
  .pcard__title a {
    color: var(--c-text);
    text-decoration: none;
  }
  /* Kartın tamamı tıklanabilir; WhatsApp butonu üstte kalır (z-index). */
  .pcard__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .pcard__title a:hover,
  .pcard__title a:focus-visible {
    color: var(--c-accent);
  }

  /* Kotalama: ——— v3.1.5 ——— */
  .pcard__dim {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .pcard__dim-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, var(--c-line-strong) 12%, var(--c-line-strong) 88%, transparent);
    position: relative;
  }
  .pcard__dim-line::before,
  .pcard__dim-line::after {
    content: "";
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: var(--c-line-strong);
  }
  .pcard__dim-line::before { left: 12%; }
  .pcard__dim-line::after { right: 12%; }
  .pcard__dim-text {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-accent);
    white-space: nowrap;
  }

  .pcard__lead {
    color: var(--c-text-muted);
    font-size: var(--t-body);
    max-width: none;
  }

  .pcard__points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }
  .pcard__points li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-sm);
    padding: 3px var(--s-2);
  }

  /* Künye tablosu */
  .pcard__block {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--c-line-strong);
    background: var(--c-base);
  }
  .pcard__block > div {
    padding: var(--s-3) var(--s-4);
    min-width: 0;
  }
  .pcard__block > div + div {
    border-left: 1px solid var(--c-line);
  }
  .pcard__block dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-text-faint);
    margin-bottom: 2px;
  }
  .pcard__block dd {
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    line-height: 1.35;
  }
  .pcard__block .is-ok { color: #7ddc7d; }
  .pcard__block .is-warn { color: var(--c-accent); }
  .pcard__block .is-muted { color: var(--c-text-faint); }

  .pcard__cta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-6) var(--s-6);
    border-top: 1px solid var(--c-line);
  }

  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap-min);
    padding: 0 var(--s-4);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-md);
    color: var(--c-accent);
    font-weight: 600;
    font-size: var(--t-small);
    text-decoration: none;
    transition:
      background var(--d-fast) var(--e-out),
      color var(--d-fast) var(--e-out);
  }
  .pcard__more svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--d-base) var(--e-out);
  }
  .pcard__more:hover,
  .pcard__more:focus-visible {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }
  .pcard__more:hover svg {
    transform: translateX(3px);
  }

  @media (hover: hover) and (pointer: fine) {
    .pcard:hover {
      border-color: var(--c-accent-dim);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .pcard__more,
    .pcard__more svg {
      transition: none;
    }
    .pcard__more:hover svg {
      transform: none;
    }
  }
</style>
