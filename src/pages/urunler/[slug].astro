---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { getProducts, productPath, DURUM, TUR, ikon, type Product } from "../../lib/products";
import { getSoftwareIndex } from "../../lib/discover";
import { formatDate } from "../../lib/content";

/**
 * Ürün ayrıntı sayfası (ADR-021, ADR-022).
 *
 * Bölümlerin tamamı isteğe bağlı: galeri, video, özellikler, listeler, S.S.S.,
 * fiyat, uyumluluk. Verisi olmayan bölüm hiç render edilmez — yeni bir ürün
 * eklendiğinde hangi bölümlerin çıkacağını veri belirler, kod değişmez.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const urunler = await getProducts();
  return urunler.map((product, index) => ({
    params: { slug: product.data.slug },
    props: { product, index },
  }));
};

interface Props {
  product: Product;
  index: number;
}

const { product } = Astro.props as Props;
const u = product.data;
const site = Astro.site ?? new URL("https://www.ufuksen.com");

const durum = DURUM[u.durum];

/** İlgili yazılar — arşivden gerçek içerik, uydurma değil. */
const softwareIndex = await getSoftwareIndex();
const ilgiliYazilar = u.yazilim.length
  ? (softwareIndex.find((entry) => entry.tag.slug === u.yazilim[0])?.posts ?? []).slice(0, 4)
  : [];
const yazilimSlug = u.yazilim[0] ?? null;
const yazilimAdi =
  softwareIndex.find((entry) => entry.tag.slug === yazilimSlug)?.tag.name ?? null;

/** Fiyat yalnızca gerçekten girilmişse gösterilir. */
const fiyatMetni =
  u.fiyat?.tutar != null
    ? new Intl.NumberFormat("tr-TR", {
        style: "currency",
        currency: u.fiyat.paraBirimi || "TRY",
        maximumFractionDigits: 0,
      }).format(u.fiyat.tutar)
    : null;

/** Ayrıntı bölümü hiç yoksa "hazırlanıyor" notu gösterilir. */
const icerikVar =
  u.ozellikler.length > 0 || u.listeler.length > 0 || u.galeri.length > 0 || u.video !== null;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: u.ad,
  description: u.aciklama ?? u.ozet,
  applicationCategory: "DesignApplication",
  url: new URL(productPath(u.slug), site).href,
  author: { "@type": "Person", name: "Ufuk Şen", url: site.href },
  ...(u.surum ? { softwareVersion: u.surum } : {}),
  ...(u.uyumluluk.length ? { operatingSystem: u.uyumluluk.join(", ") } : {}),
  ...(u.ozellikler.length ? { featureList: u.ozellikler.map((f) => f.baslik) } : {}),
  ...(u.kapak ? { image: new URL(u.kapak.src, site).href } : {}),
  ...(u.fiyat?.tutar != null
    ? {
        offers: {
          "@type": "Offer",
          price: u.fiyat.tutar,
          priceCurrency: u.fiyat.paraBirimi || "TRY",
          ...(u.satinAlmaUrl ? { url: u.satinAlmaUrl } : {}),
        },
      }
    : {}),
};
---
{/* Meta açıklaması özeti kullanır: `aciklama` gövde metnidir, 160 karakteri aşar */}
<Base
  title={`${u.ad} — ${TUR[u.tur].tekil} | Ufuk Şen`}
  description={u.ozet}
  path={productPath(u.slug)}
  ogImage={u.kapak?.src ?? null}
  padded={false}
  jsonLd={jsonLd}
>
  <article class="p">
    {/* ---------------- Başlık ---------------- */}
    <header class="p__head">
      <nav class="p__crumb" aria-label="Konum">
        <a href="/urunler">Ürünler</a>
        <span aria-hidden="true">/</span>
        <b>{u.ad}</b>
      </nav>

      <p class="p__kind">{TUR[u.tur].tekil}</p>
      <h1>{u.ad}</h1>

      <div class="p__badges">
        <span class:list={["badge", `badge--${durum.ton}`]}>
          {durum.etiket}{u.ilerleme ? ` · %${u.ilerleme}` : ""}
        </span>
        {u.surum && <span class="badge badge--v">v{u.surum}</span>}
        {fiyatMetni && <span class="badge badge--fiyat">{fiyatMetni}</span>}
      </div>

      <p class="p__lead">{u.ozet}</p>
      {u.slogan && <p class="p__slogan">“{u.slogan}”</p>}
      {u.fiyat?.not && <p class="note">{u.fiyat.not}</p>}

      <div class="p__cta">
        {
          u.satinAlmaUrl && (
            <a class="btn-main" href={u.satinAlmaUrl} target="_blank" rel="noopener">
              Satın al{fiyatMetni ? ` — ${fiyatMetni}` : ""}
            </a>
          )
        }
        {
          u.denemeUrl && (
            <a class="btn-ghost" href={u.denemeUrl} target="_blank" rel="noopener">
              Denemeyi indir
            </a>
          )
        }
        <WhatsAppButton konu={u.ad} boyut="buyuk" etiket="WhatsApp'tan sor" />
        {
          u.iletisimEposta && (
            <a
              class="btn-ghost"
              href={`mailto:${u.iletisimEposta}?subject=${encodeURIComponent(`${u.ad} hakkında`)}`}
            >
              E-posta gönder
            </a>
          )
        }
      </div>
    </header>

    {/* ---------------- Gövde ---------------- */}
    <div class="p__body">
      {
        u.kapak && (
          <figure class="p__shot">
            <img src={u.kapak.src} alt={u.kapak.alt} loading="lazy" decoding="async" />
            {u.kapak.not && <figcaption>{u.kapak.not}</figcaption>}
          </figure>
        )
      }

      {
        u.video && (
          <section>
            <h2>{u.video.baslik ?? "Tanıtım videosu"}</h2>
            {/* Tıklanana kadar YouTube yüklenmez — sayfa hızını korur */}
            <div class="p__video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${u.video.youtubeId}`}
                title={u.video.baslik ?? `${u.ad} tanıtım videosu`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      {
        u.aciklama && (
          <section class="p__about">
            <h2>Ne işe yarar?</h2>
            <p>{u.aciklama}</p>
          </section>
        )
      }

      {
        u.ozellikler.length > 0 && (
          <section>
            <h2>Özellikler</h2>
            <ul class="feats">
              {u.ozellikler.map((feature) => (
                <li class="u-reveal">
                  <span class="feats__icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ikon(feature.ikon)} />
                  </span>
                  <b>{feature.baslik}</b>
                  <span>{feature.not}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        u.galeri.length > 0 && (
          <section>
            <h2>Ekran görüntüleri</h2>
            <div class="gal" data-lightbox>
              {u.galeri.map((g) => (
                <figure>
                  <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
                  {g.not && <figcaption>{g.not}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        u.listeler.map((liste) => (
          <section>
            <h2>{liste.baslik}</h2>
            <ul class="pats">
              {liste.ogeler.map((oge) => (
                <li>{oge}</li>
              ))}
            </ul>
            {liste.not && <p class="note">{liste.not}</p>}
          </section>
        ))
      }

      {
        u.uyumluluk.length > 0 && (
          <section>
            <h2>Uyumluluk</h2>
            <ul class="compat">
              {u.uyumluluk.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        u.sss.length > 0 && (
          <section>
            <h2>Sık sorulanlar</h2>
            <div class="sss">
              {u.sss.map((s) => (
                <details>
                  <summary>{s.soru}</summary>
                  <p>{s.cevap}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {/* Verisi henüz gelmemiş ürün: boş bölüm yerine dürüst not */}
      {
        !icerikVar && (
          <section class="pending">
            <h2>Ayrıntılar hazırlanıyor</h2>
            <p>
              {u.ad} üzerinde çalışma sürüyor
              {u.ilerleme ? ` (yaklaşık %${u.ilerleme})` : ""}. Özellik listesi ve
              ekran görüntüleri hazır olduğunda bu sayfaya eklenecek. Merak
              ettiğiniz bir şey varsa doğrudan yazabilirsiniz.
            </p>
            <WhatsAppButton konu={u.ad} etiket="Durumu sor" />
          </section>
        )
      }

      {
        ilgiliYazilar.length > 0 && (
          <section>
            <h2>{yazilimAdi} yazıları</h2>
            <p class="note">Arşivden ilgili içerikler.</p>
            <ul class="rel">
              {ilgiliYazilar.map((post) => (
                <li>
                  <a href={post.data.url}>
                    <b>{post.data.title}</b>
                    <time datetime={post.data.publishedAt}>
                      {formatDate(post.data.publishedAt)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
            {yazilimSlug && (
              <a class="rel__all" href={`/yazilim/${yazilimSlug}`}>
                Tüm {yazilimAdi} yazıları →
              </a>
            )}
          </section>
        )
      }
    </div>

    {/* ---------------- Alt iletişim ---------------- */}
    <footer class="p__foot">
      <div>
        <h2>Sorunuz mu var?</h2>
        <p>Kullanımı, uyumluluğu veya fiyatı — doğrudan bana yazın.</p>
      </div>
      <WhatsAppButton konu={u.ad} boyut="buyuk" etiket="WhatsApp'tan sor" />
    </footer>
  </article>
</Base>

<style>
  /* ---------------- Başlık ---------------- */

  .p__head {
    padding: var(--s-6);
    border-bottom: 1px solid var(--c-line-strong);
    background-color: var(--c-surface);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      radial-gradient(80% 80% at 12% 0%, rgb(255 212 0 / 0.09), transparent 62%);
    background-size:
      28px 28px,
      28px 28px,
      100% 100%;
  }

  .p__crumb {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
    margin-bottom: var(--s-4);
  }
  .p__crumb a {
    color: var(--c-text-muted);
    text-decoration: none;
    /* Dokunma hedefi 44px (AGENTS.md §6); metin küçük ama alan geniş. */
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    padding-right: var(--s-1);
  }
  .p__crumb a:hover,
  .p__crumb a:focus-visible {
    color: var(--c-accent);
  }
  .p__crumb b {
    color: var(--c-text);
    font-weight: 500;
  }

  .p__kind {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-accent);
    max-width: none;
  }

  .p__head h1 {
    font-size: clamp(1.9rem, 6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-top: var(--s-2);
  }

  .p__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px var(--s-2);
    border-radius: var(--r-pill);
    border: 1px solid currentColor;
  }
  .badge--ok { color: #7ddc7d; }
  .badge--warn { color: var(--c-accent); }
  .badge--muted { color: var(--c-text-faint); }
  .badge--v { color: var(--c-text-muted); }
  .badge--fiyat {
    color: var(--c-on-accent);
    background: var(--c-accent);
    border-color: var(--c-accent);
    font-weight: 600;
  }

  .p__lead {
    margin-top: var(--s-4);
    font-size: var(--t-body-lg);
    color: var(--c-text);
    max-width: 52ch;
  }
  .p__slogan {
    margin-top: var(--s-3);
    color: var(--c-accent);
    font-size: var(--t-body);
    max-width: 52ch;
  }

  .p__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .btn-main,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--s-6);
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: var(--t-small);
    text-decoration: none;
    transition:
      background var(--d-fast) var(--e-out),
      color var(--d-fast) var(--e-out);
  }
  .btn-main {
    background: var(--c-accent);
    color: var(--c-on-accent);
    border: 1px solid var(--c-accent);
  }
  .btn-main:hover,
  .btn-main:focus-visible {
    filter: brightness(1.08);
  }
  .btn-ghost {
    border: 1px solid var(--c-line-strong);
    color: var(--c-text-muted);
  }
  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /* ---------------- Gövde ---------------- */

  .p__body {
    padding: var(--s-8) var(--s-6);
    display: grid;
    gap: var(--s-8);
  }
  .p__body h2 {
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
    margin-bottom: var(--s-4);
  }
  .p__about p {
    color: var(--c-text-muted);
    font-size: var(--t-body);
  }
  .note {
    color: var(--c-text-faint);
    font-size: var(--t-micro);
    margin-top: var(--s-3);
    max-width: none;
  }

  .p__shot {
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-base);
  }
  .p__shot img {
    width: 100%;
    height: auto;
    display: block;
  }
  .p__shot figcaption,
  .gal figcaption {
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
    border-top: 1px solid var(--c-line);
  }

  /* Video — oranı korur, taşmaz */
  .p__video {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-base);
  }
  .p__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Galeri */
  .gal {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;
  }
  .gal figure {
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-base);
  }
  .gal img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 700px) {
    .gal {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Sık sorulanlar — JS'siz açılır kapanır */
  .sss {
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .sss details {
    background: var(--c-surface-raised);
  }
  .sss summary {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap-min);
    padding: var(--s-3) var(--s-4);
    cursor: pointer;
    color: var(--c-text);
    font-weight: 500;
    font-size: var(--t-small);
    list-style: none;
  }
  .sss summary::-webkit-details-marker {
    display: none;
  }
  .sss summary::before {
    content: "+";
    font-family: var(--font-mono);
    color: var(--c-accent);
    flex: none;
  }
  .sss details[open] summary::before {
    content: "−";
  }
  .sss summary:hover {
    background: var(--c-surface-hover);
  }
  .sss details p {
    padding: 0 var(--s-4) var(--s-4) calc(var(--s-4) + 1.1em);
    color: var(--c-text-muted);
    font-size: var(--t-small);
  }

  .feats {
    list-style: none;
    display: grid;
    gap: var(--s-4);
  }
  .feats li {
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-areas:
      "icon title"
      "icon note";
    gap: 2px var(--s-4);
    padding: var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface-raised);
  }
  .feats__icon {
    grid-area: icon;
    align-self: start;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    background: var(--c-accent-wash);
    color: var(--c-accent);
  }
  .feats__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .feats b {
    grid-area: title;
    color: var(--c-text);
    font-weight: 600;
  }
  .feats li > span:last-child {
    grid-area: note;
    color: var(--c-text-muted);
    font-size: var(--t-small);
  }
  @media (min-width: 700px) {
    .feats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pats,
  .compat {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .pats li,
  .compat li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
  .compat li {
    border-style: dashed;
    color: var(--c-text);
  }

  .pending {
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    background: var(--c-surface);
  }
  .pending p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-bottom: var(--s-4);
  }

  .rel {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .rel a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    min-height: var(--tap-min);
    background: var(--c-surface-raised);
    text-decoration: none;
    color: var(--c-text-muted);
  }
  .rel b {
    color: var(--c-text);
    font-weight: 500;
    font-size: var(--t-small);
  }
  .rel time {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
  }
  .rel a:hover,
  .rel a:focus-visible {
    background: var(--c-surface-hover);
  }
  .rel a:hover b,
  .rel a:focus-visible b {
    color: var(--c-accent);
  }
  .rel__all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: var(--s-3);
    color: var(--c-accent);
    font-size: var(--t-small);
    text-decoration: none;
  }
  .rel__all:hover,
  .rel__all:focus-visible {
    text-decoration: underline;
  }

  /* ---------------- Alt ---------------- */

  .p__foot {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-8) var(--s-6);
    border-top: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    align-items: center;
  }
  .p__foot h2 {
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
  }
  .p__foot p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-top: var(--s-2);
  }

  @media (min-width: 760px) {
    .p__head,
    .p__body,
    .p__foot {
      padding-left: var(--s-8);
      padding-right: var(--s-8);
    }
    .p__foot {
      grid-template-columns: 1fr auto;
    }
  }
</style>
