---
import Base from "../../layouts/Base.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { getVideos, videoThumb, videoWatchUrl } from "../../lib/discover";
import { formatDate } from "../../lib/content";

const videos = await getVideos();
---
<Base
  title={`Videolar — ${videos.length} eğitim ve anlatı videosu | Ufuk Şen`}
  description={`3D görselleştirme, render ve SketchUp üzerine ${videos.length} video.`}
  path="/videolar"
>
  <SectionTitle
    title="Videolar"
    as="h1"
    note={`Arşivdeki ${videos.length} video. Her biri ilgili yazıya bağlı.`}
  />

  <div class="vgrid">
    {videos.map((video) => (
      <article class="vcard u-reveal">
        <a class="vcard__thumb" href={video.postUrl}>
          <img src={videoThumb(video.id)} alt="" loading="lazy" decoding="async" width="480" height="360" />
          <span class="vcard__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 7.5 17 12l-8 4.5z"/></svg>
          </span>
        </a>
        <div class="vcard__body">
          <h2><a href={video.postUrl}>{video.postTitle}</a></h2>
          <div class="vcard__meta">
            <time datetime={video.publishedAt}>{formatDate(video.publishedAt)}</time>
            {video.categories[0] && <span>{video.categories[0]}</span>}
            <a href={videoWatchUrl(video.id)} rel="noopener" target="_blank">YouTube ↗</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .vgrid { display: grid; gap: var(--s-6); grid-template-columns: 1fr; }
  @media (min-width: 620px) { .vgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .vgrid { grid-template-columns: repeat(3, 1fr); } }

  .vcard { display: grid; gap: var(--s-3); align-content: start; }
  .vcard__thumb {
    position: relative; display: block; border-radius: var(--r-lg);
    overflow: hidden; border: 1px solid var(--c-line); background: var(--c-base);
    aspect-ratio: 16 / 9;
  }
  .vcard__thumb img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--d-base) var(--e-out), opacity var(--d-base) var(--e-out);
  }
  .vcard__play {
    position: absolute; inset: 0; margin: auto;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--c-accent); color: var(--c-on-accent);
    display: grid; place-items: center;
    transition: transform var(--d-base) var(--e-out);
  }
  .vcard__play svg { width: 26px; height: 26px; fill: currentColor; }
  @media (hover: hover) {
    .vcard__thumb:hover img { transform: scale(1.04); opacity: 0.85; }
    .vcard__thumb:hover .vcard__play { transform: scale(1.1); }
  }
  .vcard h2 { font-size: var(--t-body-lg); }
  .vcard h2 a { text-decoration: none; }
  .vcard h2 a:hover { color: var(--c-accent); }
  .vcard__meta {
    display: flex; flex-wrap: wrap; gap: var(--s-3);
    font-family: var(--font-mono); font-size: var(--t-micro); color: var(--c-text-faint);
  }
  .vcard__meta a { color: var(--c-accent); text-decoration: none; min-height: var(--tap-min); display: inline-flex; align-items: center; }
</style>
