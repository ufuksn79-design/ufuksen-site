---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getProducts, productPath, turDagilimi, TUR } from "../lib/products";

/**
 * Ürünler — teknik çizim paftası düzeni (ADR-021).
 *
 * Bu sayfa sosyal medyadan doğrudan paylaşılıyor. Gelen kişi siteyi
 * tanımıyor; ilk ekranda üç soruyu cevaplamak zorunda:
 *   1. Bu ne?      -> "SketchUp için geliştirdiğim araçlar"
 *   2. Bana ne?    -> fayda şeridi (zaman / doğruluk / güven)
 *   3. Nasıl ulaşırım? -> WhatsApp, her kartta ve altta
 *
 * Sayılar veriden hesaplanır, elle yazılmaz — ürün eklendiğinde kendiliğinden
 * güncellenir ve hiçbir zaman gerçekle çelişmez.
 */
const products = await getProducts();

const site = Astro.site ?? new URL("https://www.ufuksen.com");

/**
 * Tür süzgeci ürün sayısı arttığında kendiliğinden belirir.
 * Üç üründe süzgeç gürültüdür; sekizde gereklidir. Eşik veriye bakar,
 * ürün eklendiğinde koda dönmek gerekmez (ADR-022).
 */
const turler = turDagilimi(products);
const gosterFiltre = products.length > 4 && turler.length > 1;

/** Desteklenen SketchUp sürümleri — ürünlerin uyumluluk alanlarından toplanır. */
const sketchupSurumleri = [
  ...new Set(
    products.flatMap((p) => p.data.uyumluluk.filter((u) => /sketch\s?up/i.test(u))),
  ),
].sort();

const surumAraligi =
  sketchupSurumleri.length > 1
    ? `${sketchupSurumleri[0].replace(/\D+/g, "")}–${sketchupSurumleri.at(-1)!.replace(/\D+/g, "")}`
    : (sketchupSurumleri[0]?.replace(/\D+/g, "") ?? null);

const yayindaSayisi = products.filter((p) => p.data.durum === "aktif").length;
const toplamOzellik = products.reduce((n, p) => n + p.data.ozellikler.length, 0);

/**
 * Fayda şeridi — üçü de ürün verisindeki gerçek ifadelere dayanır,
 * pazarlama cümlesi uydurulmadı (AGENTS.md §5):
 *   - zaman    : FloorStudio açıklaması "elle yapıldığında uzun sürer"
 *   - doğruluk : "Fiziksel derz (gap) sistemi ile tamamen doğru sonuçlar"
 *   - güven    : vurgular "Tek işlem undo — güvenli üretim"
 */
const faydalar = [
  {
    ikon: "clock",
    baslik: "Saatler yerine saniyeler",
    not: "Elle çizildiğinde uzun süren zemin, panel ve dizilim işleri parametreyle tek seferde üretiliyor.",
  },
  {
    ikon: "ruler",
    baslik: "Ölçü tutar",
    not: "Fiziksel derz sistemi ve milimetre hassasiyeti — göz kararı değil, gerçek ölçü.",
  },
  {
    ikon: "undo",
    baslik: "Geri alması güvenli",
    not: "Üretim tek işlem olarak yapılır; beğenmezseniz bir Ctrl+Z ile modeliniz eski hâline döner.",
  },
];

const faydaIkon: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  ruler:
    '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/>',
  undo: '<path d="M4 9h10a5.5 5.5 0 0 1 0 11h-3"/><path d="M8 4.5 3.5 9 8 13.5"/>',
};
---

<Base
  title="SketchUp Eklentileri ve Araçlar | Ufuk Şen"
  description={`SketchUp için geliştirdiğim eklentiler: ${products.map((p) => p.data.ad).join(", ")}. Zemin, mutfak ve panel işlerini ölçülü ve hızlı üretin.`}
  path="/urunler"
  padded={false}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Ufuk Şen ürünleri",
    numberOfItems: products.length,
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "SoftwareApplication",
        name: product.data.ad,
        description: product.data.ozet,
        applicationCategory: "DesignApplication",
        ...(product.data.surum ? { softwareVersion: product.data.surum } : {}),
        ...(product.data.uyumluluk.length
          ? { operatingSystem: product.data.uyumluluk.join(", ") }
          : {}),
        url: new URL(productPath(product.data.slug), site).href,
      },
    })),
  }}
>
  {/* ---------------- Giriş: sayfa ne hakkında ---------------- */}
  <header class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">Ufuk Şen · Geliştirdiğim araçlar</p>
      <h1 class="hero__title">
        SketchUp'ta<br /><span>çizimi hızlandıran</span><br />eklentiler
      </h1>
      <p class="hero__lead">
        Zemin, mutfak ve panel işlerini elle çizmek yerine parametreyle üretin.
        Ölçüler gerçek, sonuç modelin içinde — kopyala-yapıştır değil.
      </p>

      <ul class="hero__stats">
        <li><b>{products.length}</b><span>araç</span></li>
        {yayindaSayisi > 0 && <li><b>{yayindaSayisi}</b><span>yayında</span></li>}
        {surumAraligi && <li><b>{surumAraligi}</b><span>SketchUp sürümü</span></li>}
        {toplamOzellik > 0 && <li><b>{toplamOzellik}</b><span>özellik</span></li>}
      </ul>

      <div class="hero__cta">
        <a class="hero__jump" href="#araclar">Araçları gör</a>
        <WhatsAppButton boyut="buyuk" etiket="WhatsApp'tan yaz" />
      </div>
    </div>

    {/*
      İzometrik tel kafes — kalemle çizilir gibi belirir (ADR-021).

      Elle çizim izlenimi üç şeyden geliyor, hiçbiri filtre değil (filtre her
      karede yeniden rasterleştirme demek, animasyon takılırdı):
        1. Kenarlar düz değil, hafif eğri (Bézier) ve köşelerde taşma var.
        2. Her kenarın üstünden soluk bir ikinci geçiş yapılıyor — çizen kişinin
           çizgiyi tekrar geçmesi gibi.
        3. Çizim sırasında ucunda gerçek bir kalem yol boyunca ilerliyor.

      `pathLength="1"` ile yol uzunluğu 1'e normalize edilir; böylece
      stroke-dashoffset animasyonu ölçü hesabı gerektirmez.
    */}
    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 260 240" fill="none" stroke-linecap="round" stroke-linejoin="round">
        {/* Cetvelle çizilmiş yardımcı çizgiler — serbest elle çizilen kutuya zemin */}
        <g class="art-grid" stroke="currentColor" stroke-width="1">
          <path d="M10 170 130 100 250 170 130 240Z" />
          <path d="M40 170 130 118M70 170 130 135M100 170 130 152" />
          <path d="M220 170 130 118M190 170 130 135M160 170 130 152" />
        </g>

        {/* İkinci geçiş: soluk, ilkiyle tam örtüşmeyen çizgiler */}
        <g class="art-ghost" stroke-width="1.6">
          <path
            class="ghost ghost--blue"
            pathLength="1"
            stroke="#3b82f6"
            d="M59 129.5C83 118 107 100.5 131 88.5C154.5 102.5 178.5 117.5 201 130.5C178.5 145 154 158 130.5 171C106 158.5 82 143.5 58.5 130.5"
          />
          <path
            class="ghost ghost--green"
            pathLength="1"
            stroke="#46a758"
            d="M60.5 131.5C59.5 119 61.5 102 60 87.5M199.5 131.5C200.5 119 198.5 102 200 87.5M129.5 171.5C130.5 159 128.5 142 130 127.5"
          />
          <path
            class="ghost ghost--red"
            pathLength="1"
            stroke="#e5484d"
            d="M58 88.5C82 78 105 59 131 48C155 60.5 178 75.5 202 90C179 103 154.5 116.5 129 129C105.5 116.5 82 101.5 58 89.5"
          />
        </g>

        {/* Ana çizgiler — SketchUp eksen renkleri */}
        <g class="art-box" stroke-width="2.2">
          <path
            id="yol-mavi"
            class="edge edge--blue"
            pathLength="1"
            stroke="#3b82f6"
            d="M58 131C82 118.5 106 101.5 130 89C154 101.5 178 118.5 202 131C178 146 154 157.5 130 172C106 159.5 81.5 142.5 57 130"
          />
          <path
            id="yol-yesil"
            class="edge edge--green"
            pathLength="1"
            stroke="#46a758"
            d="M59.5 132.5C60.5 120 58.5 101 59 86.5M200.5 132.5C199.5 120 201.5 101 201 86.5M130.5 172.5C131.5 160 129.5 141 130 126.5"
          />
          <path
            id="yol-kirmizi"
            class="edge edge--red"
            pathLength="1"
            stroke="#e5484d"
            d="M57 90C81 77 106 60 130 47C154 59.5 179 76.5 203 89C178 104 155 115.5 130 130C106 117.5 81 100.5 57.5 88.5"
          />
        </g>

        <g class="art-dim" stroke="currentColor" stroke-width="1">
          <path d="M215 92 232 92M215 134 232 134M223 92v42" />
        </g>

        {/*
          Kalem — ucu (0,0) noktasında, gövdesi yukarı sağa uzanıyor.

          Hareket için CSS `offset-path` değil SVG'nin kendi `animateMotion`'ı
          kullanılıyor: offset-path SVG kullanıcı birimleriyle hizalanmıyordu
          (kalem çizimin 141px üstünde kalıyordu, ölçüldü). `animateMotion`
          elemanın (0,0) noktasını yol üzerinde yürütür — kalemin ucu tam
          çizginin ucunda oluyor, dönüşüm hesabı gerekmiyor.

          Görünürlük de SMIL ile veriliyor; CSS `opacity` SMIL ile çakışırdı.
        */}
        <g class="pen pen--blue" opacity="0">
          <path d="M0 0 4.49-1.87 1.87-4.49Z" fill="#d8d8dd" />
          <path d="M1.87-4.49 4.49-1.87 12.62-10 10-12.62Z" fill="#ffd400" />
          <path d="M10-12.62 12.62-10 14.39-11.77 11.77-14.39Z" fill="#8a8a92" />
          <animateMotion dur="0.75s" begin="0.35s" fill="freeze" calcMode="linear">
            <mpath href="#yol-mavi" xlink:href="#yol-mavi" />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="1;1;0"
            keyTimes="0;0.88;1"
            dur="0.75s"
            begin="0.35s"
            fill="freeze"
          />
        </g>
        <g class="pen pen--green" opacity="0">
          <path d="M0 0 4.49-1.87 1.87-4.49Z" fill="#d8d8dd" />
          <path d="M1.87-4.49 4.49-1.87 12.62-10 10-12.62Z" fill="#ffd400" />
          <path d="M10-12.62 12.62-10 14.39-11.77 11.77-14.39Z" fill="#8a8a92" />
          <animateMotion dur="0.4s" begin="1.1s" fill="freeze" calcMode="linear">
            <mpath href="#yol-yesil" xlink:href="#yol-yesil" />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="1;1;0"
            keyTimes="0;0.88;1"
            dur="0.4s"
            begin="1.1s"
            fill="freeze"
          />
        </g>
        <g class="pen pen--red" opacity="0">
          <path d="M0 0 4.49-1.87 1.87-4.49Z" fill="#d8d8dd" />
          <path d="M1.87-4.49 4.49-1.87 12.62-10 10-12.62Z" fill="#ffd400" />
          <path d="M10-12.62 12.62-10 14.39-11.77 11.77-14.39Z" fill="#8a8a92" />
          <animateMotion dur="0.75s" begin="1.5s" fill="freeze" calcMode="linear">
            <mpath href="#yol-kirmizi" xlink:href="#yol-kirmizi" />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="1;1;0"
            keyTimes="0;0.88;1"
            dur="0.75s"
            begin="1.5s"
            fill="freeze"
          />
        </g>
      </svg>
    </div>
  </header>

  {/* ---------------- Fayda şeridi ---------------- */}
  <section class="why" aria-label="Bu araçlar ne kazandırır">
    {
      faydalar.map((f) => (
        <div class="why__item u-reveal">
          <span class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={faydaIkon[f.ikon]} />
          </span>
          <b>{f.baslik}</b>
          <p>{f.not}</p>
        </div>
      ))
    }
  </section>

  {/* ---------------- Ürünler ---------------- */}
  <section class="sheet" id="araclar">
    <div class="sheet__head">
      <h2>Araçlar</h2>
      <p>Her birinin kendi sayfası var — ayrıntılar, uyumluluk ve iletişim orada.</p>
    </div>

    {/*
      Tür süzgeci — JavaScript'siz. Gizli radyo düğmeleri + `:has()` ile
      çalışır; JS kapalıysa ya da `:has()` desteklenmiyorsa tüm ürünler
      görünür kalır, hiçbir şey kaybolmaz (ADR-005).
    */}
    {
      gosterFiltre && (
        <fieldset class="filtre">
          <legend class="u-visually-hidden">Türe göre süz</legend>
          <input type="radio" name="urun-turu" id="filtre-tumu" checked />
          <label for="filtre-tumu">Tümü <span>{products.length}</span></label>
          {turler.map(({ tur, adet }) => (
            <>
              <input type="radio" name="urun-turu" id={`filtre-${tur}`} />
              <label for={`filtre-${tur}`}>
                {TUR[tur].cogul} <span>{adet}</span>
              </label>
            </>
          ))}
        </fieldset>
      )
    }

    <div class="sheet__grid">
      {
        products.map((product, index) => (
          <div class="sheet__cell" data-tur={product.data.tur}>
            <ProductCard product={product} index={index} />
          </div>
        ))
      }
    </div>
  </section>

  {/* ---------------- İletişim ---------------- */}
  <section class="ask">
    <div>
      <h2>Hangisi işinize yarar, birlikte bakalım</h2>
      <p>
        Hangi aracın işinizi hızlandıracağından emin değilseniz yazın — ne
        yaptığınızı anlatın, size uygun olanı söyleyeyim.
      </p>
    </div>
    <WhatsAppButton boyut="buyuk" etiket="WhatsApp'tan yaz" />
  </section>
</Base>

<style>
  /* ---------------- Giriş ---------------- */

  .hero {
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding: var(--s-8) var(--s-6);
    border-bottom: 1px solid var(--c-line-strong);
    /* SketchUp zemin ızgarası */
    background-color: var(--c-surface);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      radial-gradient(90% 70% at 15% 0%, rgb(255 212 0 / 0.09), transparent 60%);
    background-size:
      30px 30px,
      30px 30px,
      100% 100%;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-accent);
    max-width: none;
  }

  .hero__title {
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-top: var(--s-3);
    color: var(--c-text);
  }
  .hero__title span {
    color: var(--c-accent);
  }

  .hero__lead {
    margin-top: var(--s-4);
    color: var(--c-text-muted);
    font-size: var(--t-body-lg);
    max-width: 46ch;
  }

  .hero__stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__stats li {
    display: flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    padding: var(--s-2) var(--s-3);
    background: rgb(0 0 0 / 0.25);
  }
  .hero__stats b {
    font-size: var(--t-h3);
    color: var(--c-text);
    line-height: 1;
  }
  .hero__stats span {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__jump {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--s-6);
    border-radius: var(--r-md);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition: filter var(--d-fast) var(--e-out);
  }
  .hero__jump:hover,
  .hero__jump:focus-visible {
    filter: brightness(1.08);
  }

  .hero__art {
    color: var(--c-line-strong);
    justify-self: center;
    width: min(100%, 300px);
  }
  .hero__art svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .art-grid {
    opacity: 0.5;
  }
  .art-dim {
    opacity: 0.7;
  }
  /* İkinci geçiş her zaman soluk — çizgiyi tekrar geçmiş el izlenimi */
  .art-ghost {
    opacity: 0.28;
  }
  /* Hareket azaltma tercihinde kalem hiç görünmez (SMIL'i CSS durduramaz,
     bu yüzden görünürlük değil yerleşim üzerinden kapatılıyor). */
  @media (prefers-reduced-motion: reduce) {
    .pen {
      display: none;
    }
  }

  /**
   * Kalemle çizim animasyonu.
   *
   * Sıra gerçek bir eskizdeki gibi: önce taban, sonra dikmeler, en son üst yüz.
   * Kalem her aşamada o kenarın yolunu izler (`offset-path`), ucu yol üzerinde
   * kalsın diye `offset-anchor` kalemin sol-alt köşesine sabitlenir.
   * `offset-rotate: 0deg` — kalem elde tutulmuş gibi sabit açıda kalır.
   */
  @media (prefers-reduced-motion: no-preference) {
    .edge,
    .ghost {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: cizgi-cek var(--sure) var(--e-inout) var(--gecikme) forwards;
    }

    .edge--blue,
    .ghost--blue { --sure: 0.75s; --gecikme: 0.35s; }
    .edge--green,
    .ghost--green { --sure: 0.4s; --gecikme: 1.1s; }
    .edge--red,
    .ghost--red { --sure: 0.75s; --gecikme: 1.5s; }

    /* İkinci geçiş bir tık geriden gelir — üst üste değil, ardından */
    .ghost--blue { --gecikme: 0.5s; }
    .ghost--green { --gecikme: 1.2s; }
    .ghost--red { --gecikme: 1.65s; }

    @keyframes cizgi-cek {
      to { stroke-dashoffset: 0; }
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.35fr 1fr;
      align-items: center;
      padding: var(--s-12) var(--s-8);
      gap: var(--s-8);
    }
    .hero__art {
      width: min(100%, 340px);
    }
  }

  /* ---------------- Fayda şeridi ---------------- */

  .why {
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border-bottom: 1px solid var(--c-line-strong);
  }
  .why__item {
    background: var(--c-surface-raised);
    padding: var(--s-6);
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .why__icon {
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    background: var(--c-accent-wash);
    color: var(--c-accent);
    margin-bottom: var(--s-1);
  }
  .why__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .why__item b {
    color: var(--c-text);
    font-size: var(--t-body-lg);
    font-weight: 600;
  }
  .why__item p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    max-width: none;
  }
  @media (min-width: 760px) {
    .why {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------------- Ürün paftaları ---------------- */

  .sheet {
    padding: var(--s-8) var(--s-6);
  }
  .sheet__head {
    margin-bottom: var(--s-6);
  }
  .sheet__head h2 {
    font-size: var(--t-h2);
    letter-spacing: var(--ls-heading);
  }
  .sheet__head p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-top: var(--s-2);
    max-width: none;
  }
  /* --- Tür süzgeci (JS'siz) --- */

  .filtre {
    border: 0;
    padding: 0;
    margin: 0 0 var(--s-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .filtre input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .filtre label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap-min);
    padding: 0 var(--s-4);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    color: var(--c-text-muted);
    font-size: var(--t-small);
    cursor: pointer;
    transition:
      border-color var(--d-fast) var(--e-out),
      color var(--d-fast) var(--e-out),
      background var(--d-fast) var(--e-out);
  }
  .filtre label span {
