---
import Base from "../layouts/Base.astro";
import ProductCard, { type Product } from "../components/ProductCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import productData from "../content/products.json";

/**
 * Ürünler — teknik çizim paftası düzeni (ADR-021).
 *
 * Bu sayfa sosyal medyadan doğrudan paylaşılıyor. Gelen kişi siteyi
 * tanımıyor; ilk ekranda üç soruyu cevaplamak zorunda:
 *   1. Bu ne?      -> "SketchUp için geliştirdiğim araçlar"
 *   2. Bana ne?    -> fayda şeridi (zaman / doğruluk / güven)
 *   3. Nasıl ulaşırım? -> WhatsApp, her kartta ve altta
 *
 * Sayılar veriden hesaplanır, elle yazılmaz — ürün eklendiğinde kendiliğinden
 * güncellenir ve hiçbir zaman gerçekle çelişmez.
 */
const products = productData.urunler as Product[];

const site = Astro.site ?? new URL("https://www.ufuksen.com");

/** Desteklenen SketchUp sürümleri — ürünlerin uyumluluk alanlarından toplanır. */
const sketchupSurumleri = [
  ...new Set(
    products.flatMap((p) => p.uyumluluk.filter((u) => /sketch\s?up/i.test(u))),
  ),
].sort();

const surumAraligi =
  sketchupSurumleri.length > 1
    ? `${sketchupSurumleri[0].replace(/\D+/g, "")}–${sketchupSurumleri.at(-1)!.replace(/\D+/g, "")}`
    : (sketchupSurumleri[0]?.replace(/\D+/g, "") ?? null);

const yayindaSayisi = products.filter((p) => p.durum === "aktif").length;
const toplamOzellik = products.reduce((n, p) => n + p.ozellikler.length, 0);

/**
 * Fayda şeridi — üçü de ürün verisindeki gerçek ifadelere dayanır,
 * pazarlama cümlesi uydurulmadı (AGENTS.md §5):
 *   - zaman    : FloorStudio açıklaması "elle yapıldığında uzun sürer"
 *   - doğruluk : "Fiziksel derz (gap) sistemi ile tamamen doğru sonuçlar"
 *   - güven    : vurgular "Tek işlem undo — güvenli üretim"
 */
const faydalar = [
  {
    ikon: "clock",
    baslik: "Saatler yerine saniyeler",
    not: "Elle çizildiğinde uzun süren zemin, panel ve dizilim işleri parametreyle tek seferde üretiliyor.",
  },
  {
    ikon: "ruler",
    baslik: "Ölçü tutar",
    not: "Fiziksel derz sistemi ve milimetre hassasiyeti — göz kararı değil, gerçek ölçü.",
  },
  {
    ikon: "undo",
    baslik: "Geri alması güvenli",
    not: "Üretim tek işlem olarak yapılır; beğenmezseniz bir Ctrl+Z ile modeliniz eski hâline döner.",
  },
];

const faydaIkon: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  ruler:
    '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/>',
  undo: '<path d="M4 9h10a5.5 5.5 0 0 1 0 11h-3"/><path d="M8 4.5 3.5 9 8 13.5"/>',
};
---

<Base
  title="SketchUp Eklentileri ve Araçlar | Ufuk Şen"
  description={`SketchUp için geliştirdiğim eklentiler: ${products.map((p) => p.ad).join(", ")}. Zemin, mutfak ve panel işlerini ölçülü ve hızlı üretin.`}
  path="/urunler"
  padded={false}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Ufuk Şen ürünleri",
    numberOfItems: products.length,
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "SoftwareApplication",
        name: product.ad,
        description: product.ozet,
        applicationCategory: "DesignApplication",
        ...(product.surum ? { softwareVersion: product.surum } : {}),
        ...(product.uyumluluk.length
          ? { operatingSystem: product.uyumluluk.join(", ") }
          : {}),
        url: new URL(`/urunler/${product.slug}`, site).href,
      },
    })),
  }}
>
  {/* ---------------- Giriş: sayfa ne hakkında ---------------- */}
  <header class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">Ufuk Şen · Geliştirdiğim araçlar</p>
      <h1 class="hero__title">
        SketchUp'ta<br /><span>çizimi hızlandıran</span><br />eklentiler
      </h1>
      <p class="hero__lead">
        Zemin, mutfak ve panel işlerini elle çizmek yerine parametreyle üretin.
        Ölçüler gerçek, sonuç modelin içinde — kopyala-yapıştır değil.
      </p>

      <ul class="hero__stats">
        <li><b>{products.length}</b><span>araç</span></li>
        {yayindaSayisi > 0 && <li><b>{yayindaSayisi}</b><span>yayında</span></li>}
        {surumAraligi && <li><b>{surumAraligi}</b><span>SketchUp sürümü</span></li>}
        {toplamOzellik > 0 && <li><b>{toplamOzellik}</b><span>özellik</span></li>}
      </ul>

      <div class="hero__cta">
        <a class="hero__jump" href="#araclar">Araçları gör</a>
        <WhatsAppButton boyut="buyuk" etiket="WhatsApp'tan yaz" />
      </div>
    </div>

    {/* İzometrik tel kafes — SketchUp eksen renkleriyle. Süsleme katmanı. */}
    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 260 240" fill="none" stroke-linecap="round">
        <g class="art-grid" stroke="currentColor" stroke-width="1">
          <path d="M10 170 130 100 250 170 130 240Z" />
          <path d="M40 170 130 118M70 170 130 135M100 170 130 152" />
          <path d="M220 170 130 118M190 170 130 135M160 170 130 152" />
        </g>
        <g class="art-box" stroke-width="2">
          <path d="M60 130 130 90 200 130 130 170Z" stroke="#3b82f6" />
          <path d="M60 130v-42M200 130V88M130 170v-42" stroke="#46a758" />
          <path d="M60 88 130 48 200 88 130 128Z" stroke="#e5484d" />
        </g>
        <g class="art-dim" stroke="currentColor" stroke-width="1">
          <path d="M215 92 232 92M215 134 232 134M223 92v42" />
        </g>
      </svg>
    </div>
  </header>

  {/* ---------------- Fayda şeridi ---------------- */}
  <section class="why" aria-label="Bu araçlar ne kazandırır">
    {
      faydalar.map((f) => (
        <div class="why__item u-reveal">
          <span class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={faydaIkon[f.ikon]} />
          </span>
          <b>{f.baslik}</b>
          <p>{f.not}</p>
        </div>
      ))
    }
  </section>

  {/* ---------------- Ürünler ---------------- */}
  <section class="sheet" id="araclar">
    <div class="sheet__head">
      <h2>Araçlar</h2>
      <p>Her birinin kendi sayfası var — ayrıntılar, uyumluluk ve iletişim orada.</p>
    </div>

    <div class="sheet__grid">
      {products.map((product, index) => <ProductCard product={product} index={index} />)}
    </div>
  </section>

  {/* ---------------- İletişim ---------------- */}
  <section class="ask">
    <div>
      <h2>Hangisi işinize yarar, birlikte bakalım</h2>
      <p>
        Hangi aracın işinizi hızlandıracağından emin değilseniz yazın — ne
        yaptığınızı anlatın, size uygun olanı söyleyeyim.
      </p>
    </div>
    <WhatsAppButton boyut="buyuk" etiket="WhatsApp'tan yaz" />
  </section>
</Base>

<style>
  /* ---------------- Giriş ---------------- */

  .hero {
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding: var(--s-8) var(--s-6);
    border-bottom: 1px solid var(--c-line-strong);
    /* SketchUp zemin ızgarası */
    background-color: var(--c-surface);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      radial-gradient(90% 70% at 15% 0%, rgb(255 212 0 / 0.09), transparent 60%);
    background-size:
      30px 30px,
      30px 30px,
      100% 100%;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-accent);
    max-width: none;
  }

  .hero__title {
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-top: var(--s-3);
    color: var(--c-text);
  }
  .hero__title span {
    color: var(--c-accent);
  }

  .hero__lead {
    margin-top: var(--s-4);
    color: var(--c-text-muted);
    font-size: var(--t-body-lg);
    max-width: 46ch;
  }

  .hero__stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__stats li {
    display: flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    padding: var(--s-2) var(--s-3);
    background: rgb(0 0 0 / 0.25);
  }
  .hero__stats b {
    font-size: var(--t-h3);
    color: var(--c-text);
    line-height: 1;
  }
  .hero__stats span {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-faint);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__jump {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--s-6);
    border-radius: var(--r-md);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition: filter var(--d-fast) var(--e-out);
  }
  .hero__jump:hover,
  .hero__jump:focus-visible {
    filter: brightness(1.08);
  }

  .hero__art {
    color: var(--c-line-strong);
    justify-self: center;
    width: min(100%, 300px);
  }
  .hero__art svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .art-grid {
    opacity: 0.5;
  }
  .art-dim {
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .art-box path {
      stroke-dasharray: 340;
      stroke-dashoffset: 340;
      animation: draw 1.1s var(--e-out) forwards;
    }
    .art-box path:nth-child(2) { animation-delay: 0.18s; }
    .art-box path:nth-child(3) { animation-delay: 0.36s; }
    @keyframes draw {
      to { stroke-dashoffset: 0; }
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.35fr 1fr;
      align-items: center;
      padding: var(--s-12) var(--s-8);
      gap: var(--s-8);
    }
    .hero__art {
      width: min(100%, 340px);
    }
  }

  /* ---------------- Fayda şeridi ---------------- */

  .why {
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border-bottom: 1px solid var(--c-line-strong);
  }
  .why__item {
    background: var(--c-surface-raised);
    padding: var(--s-6);
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .why__icon {
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    background: var(--c-accent-wash);
    color: var(--c-accent);
    margin-bottom: var(--s-1);
  }
  .why__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .why__item b {
    color: var(--c-text);
    font-size: var(--t-body-lg);
    font-weight: 600;
  }
  .why__item p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    max-width: none;
  }
  @media (min-width: 760px) {
    .why {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------------- Ürün paftaları ---------------- */

  .sheet {
    padding: var(--s-8) var(--s-6);
  }
  .sheet__head {
    margin-bottom: var(--s-6);
  }
  .sheet__head h2 {
    font-size: var(--t-h2);
    letter-spacing: var(--ls-heading);
  }
  .sheet__head p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-top: var(--s-2);
    max-width: none;
  }
  .sheet__grid {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .sheet {
      padding: var(--s-12) var(--s-8);
    }
    .sheet__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---------------- İletişim ---------------- */

  .ask {
    display: grid;
    gap: var(--s-6);
    padding: var(--s-8) var(--s-6);
    border-top: 1px solid var(--c-line-strong);
    background: var(--c-surface);
    align-items: center;
  }
  .ask h2 {
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
  }
  .ask p {
    color: var(--c-text-muted);
    font-size: var(--t-small);
    margin-top: var(--s-2);
  }
  @media (min-width: 760px) {
    .ask {
      grid-template-columns: 1fr auto;
      padding: var(--s-8);
    }
  }
</style>
