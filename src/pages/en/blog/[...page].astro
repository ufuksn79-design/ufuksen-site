---
/**
 * Blog listing — English interface. Önce İngilizce yazılar, sonra Türkçe
 * arşiv (ADR-027: bazı yazıların İngilizce karşılığı var).
 *
 * Gövde `BlogPage` bileşeninde; iki dil aynı bileşeni kullanır (ADR-025).
 */
import type { GetStaticPaths, Page } from "astro";
import BlogPage from "../../../components/pages/BlogPage.astro";
import { getPosts, type Post } from "../../../lib/content";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const ingilizce = await getPosts("en");
  const turkce = await getPosts("tr");
  return paginate([...ingilizce, ...turkce], { pageSize: 20 });
};

const { page } = Astro.props as { page: Page<Post> };
---

<BlogPage page={page} dil="en" />
