---
/**
 * Blog listing — English interface, Turkish articles.
 *
 * Gövde `BlogPage` bileşeninde; iki dil aynı bileşeni kullanır (ADR-025).
 */
import type { GetStaticPaths, Page } from "astro";
import BlogPage from "../../../components/pages/BlogPage.astro";
import { getPosts, type Post } from "../../../lib/content";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 20 });
};

const { page } = Astro.props as { page: Page<Post> };
---

<BlogPage page={page} dil="en" />
