---
import Base from "../layouts/Base.astro";
import SectionTitle from "../components/SectionTitle.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getPosts, getVisibleCategories, categoryPath, formatDate, summarize } from "../lib/content";
import { getVideos, videoThumb } from "../lib/discover";
import CourseCard, { type Course } from "../components/CourseCard.astro";
import courseData from "../content/courses.json";
import { getProducts, productPath } from "../lib/products";
import seo from "../content/seo.json";

const posts = await getPosts();
const categories = await getVisibleCategories();
const latest = posts.slice(0, 4);
const allVideos = await getVideos();
const videos = allVideos.slice(0, 6);
const courses = (courseData.kurslar as Course[]).slice(0, 3);
const courseCount = courseData.kurslar.length;
const products = await getProducts();
const totalPosts = posts.length;

const site = Astro.site ?? new URL("https://www.ufuksen.com");

/**
 * YER TUTUCU İÇERİK (AGENTS.md §5, ADR-016).
 *
 * Aşağıdaki bloklar için gerçek veri yok. `placeholder: true` taşıyanlar
 * arayüzde açıkça etiketlenir ve gerçek bilgi gibi sunulmaz.
 * Profil fotoğrafı ve kapak görseli kullanıcıdan gelecek.
 */
const AVATAR_SRC: string | null = null; // kullanıcıdan gelecek
const COVER_SRC: string | null = null; // kullanıcıdan gelecek


const skills = [
  { name: "SketchUp", level: 96 },
  { name: "D5 Render", level: 90 },
  { name: "Twinmotion", level: 85 },
  { name: "Enscape", level: 82 },
  { name: "V-Ray", level: 80 },
  { name: "Lumion", level: 72 },
];

/** Sayaçlar — bunlar gerçek, arşivden ölçüldü. */
const counters = [
  { value: totalPosts, suffix: "", label: "Yayımlanmış yazı" },
  { value: categories.length, suffix: "", label: "Kategori" },
  { value: 1819, suffix: "", label: "Görsel arşivi" },
  { value: 10, suffix: "+", label: "Yıllık deneyim" },
];

---

<Base
  title="Ufuk Şen — 3D Görselleştirme, Render ve SketchUp Eğitimleri"
  description="SketchUp, Twinmotion, D5 Render ve Enscape üzerine eğitimler, eklentiler ve mimari görselleştirme projeleri."
  path="/"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: seo.kisiAdi || "Ufuk Şen",
    jobTitle: seo.kisiUnvani || "3D Görselleştirme Uzmanı ve Eğitmen",
    url: site.href,
    address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
    knowsAbout: ["SketchUp", "Twinmotion", "D5 Render", "Enscape", "V-Ray", "Mimari görselleştirme"],
  }}
>
  <!-- PROFİL KARTI -->
  <section class="profile">
    <div class="profile__cover">
      {COVER_SRC && <img src={COVER_SRC} alt="" />}
    </div>
    <div class="profile__body">
      <div class="profile__avatar">
        {AVATAR_SRC ? <img src={AVATAR_SRC} alt="Ufuk Şen" /> : <span aria-hidden="true">UŞ</span>}
      </div>
      <h1 class="profile__name">Ufuk Şen</h1>
      <p class="profile__role">3D Görselleştirme Uzmanı · Eğitmen · Ankara</p>
      <SocialLinks variant="row" />
      <p class="tag tag--placeholder" style="justify-self:center">
        Profil ve kapak görseli yer tutucu
      </p>
    </div>
    <div class="profile__cta">
      <a href="/blog">Yazıları oku</a>
      <a href="/iletisim">İletişime geç</a>
    </div>
  </section>

  <!-- HAKKIMDA -->
  <section class="block u-reveal">
    <SectionTitle title="Hakkımda" />
    <div class="about">
      <div>
        <p style="color:var(--c-text);font-weight:600;margin-bottom:var(--s-2)">
          Merhaba, ben Ufuk Şen.
        </p>
        <p style="color:var(--c-text-muted)">
          Mimari görselleştirme üretiyor ve bu işi öğretiyorum. Yazılım öğretmiyorum; ışığı,
          malzemeyi ve kadrajı öğretiyorum. Yazılım bunun aracı.
          {` Arşivde ${totalPosts} yazı, ${categories.length} konu başlığı ve on yılı aşkın üretim birikimi var.`}
        </p>
      </div>
      <dl class="facts">
        <div><dt>Konum</dt><span class="dots"></span><dd>Ankara, Türkiye</dd></div>
        <div><dt>Uzmanlık</dt><span class="dots"></span><dd>3D görselleştirme ve render</dd></div>
        <div><dt>Eğitim</dt><span class="dots"></span><dd>Birebir ve video</dd></div>
        <div><dt>Arşiv</dt><span class="dots"></span><dd>{totalPosts} yazı</dd></div>
      </dl>
    </div>
  </section>

  <!-- ÜRÜNLER -->
  <section class="block u-reveal">
    <SectionTitle
      title="Ürünler"
      note="Geliştirdiğim eklentiler ve araçlar."
    />
    <div class="tiles">
      {
        products.map((product) => (
          <article class="tile">
            <span class="tag">
              {product.data.surum
                ? `v${product.data.surum}`
                : product.data.ilerleme
                  ? `Geliştiriliyor · %${product.data.ilerleme}`
                  : product.data.durum}
            </span>
            <h3>{product.data.ad}</h3>
            <p>{product.data.ozet}</p>
            {/* Her ürünün kendi sayfası var (ADR-021) */}
            <a class="tile__link" href={productPath(product.data.slug)}>Detay <i>→</i></a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- EĞİTİM SETLERİ -->
  <section class="block u-reveal">
    <SectionTitle
      title="Eğitim Setleri"
      note={`Udemy'de yayında olan ${courseCount} eğitim seti. En yüksek puanlı üçü aşağıda.`}
    />
    <div class="courses">
      {courses.map((course) => <CourseCard course={course} />)}
    </div>
    <div style="margin-top:var(--s-6)">
      <a class="btn btn--ghost" href="/egitimler">Tüm eğitim setleri ({courseCount})</a>
    </div>
  </section>

  <!-- UZMANLIK -->
  <section class="block u-reveal">
    <SectionTitle
      title="Uzmanlık"
      note="Seviye göstergeleri yer tutucudur; ölçülmüş bir değerlendirmeye dayanmaz."
    />
    <div class="skills">
      {
        skills.map((skill) => (
          <div class="skill u-reveal">
            <div class="skill__head">
              <b>{skill.name}</b>
              <span>{skill.level}%</span>
            </div>
            <div class="skill__bar">
              <i style={`--w:${skill.level}%`} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SAYAÇLAR -->
  <section class="block u-reveal">
    <SectionTitle title="Rakamlar" note="Bu değerler arşivden ölçüldü." />
    <div class="counters">
      {
        counters.map((counter) => (
          <div class="counter">
            <b data-count={counter.value} data-suffix={counter.suffix}>
              {counter.value.toLocaleString("tr-TR")}
              {counter.suffix}
            </b>
            <span>{counter.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- VİDEOLAR -->
  <section class="block u-reveal">
    <SectionTitle
      title="Videolar"
      note={`Arşivde ${allVideos.length} video var. En yenileri aşağıda.`}
    />
    <div class="vstrip">
      {
        videos.map((video) => (
          <a class="vmini" href={video.postUrl}>
            <img src={videoThumb(video.id)} alt="" loading="lazy" decoding="async" width="320" height="180" />
            <span class="vmini__title">{video.postTitle}</span>
          </a>
        ))
      }
    </div>
    <div style="margin-top:var(--s-6)">
      <a class="btn btn--ghost" href="/videolar">Tüm videolar</a>
    </div>
  </section>

  <!-- KONULAR -->
  <section class="block u-reveal">
    <SectionTitle title="Konular" note={`${totalPosts} yazı, ${categories.length} başlık altında.`} />
    <div class="tiles">
      {
        categories.slice(0, 4).map((category) => (
          <article class="tile">
            <span class="tag">{category.postCount} yazı</span>
            <h3>{category.name}</h3>
            {category.description && <p>{category.description}</p>}
            <a class="tile__link" href={categoryPath(category)}>
              Kategoriye git <i>→</i>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- SON YAZILAR -->
  <section class="block u-reveal">
    <SectionTitle title="Son yazılar" note="Arşivin tamamı blog sayfasında." />
    <div>
      {
        latest.map((post) => (
          <article class={`post-item ${post.data.featuredImage?.localPath ? "post-item--with-thumb" : ""}`}>
            {post.data.featuredImage?.localPath && (
              <img
                class="post-item__thumb"
                src={post.data.featuredImage.localPath}
                alt={post.data.featuredImage.alt || post.data.title}
                width={post.data.featuredImage.width ?? undefined}
                height={post.data.featuredImage.height ?? undefined}
                loading="lazy"
                decoding="async"
              />
            )}
            <div style="display:grid;gap:var(--s-2)">
              <div class="post-item__meta">
                <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
                <span>{post.data.readingMinutes} dk</span>
              </div>
              <h3>
                <a href={post.data.url}>{post.data.title}</a>
              </h3>
              <p>{summarize(post, 140)}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div style="margin-top:var(--s-8)">
      <a class="btn btn--ghost" href="/blog">Tüm yazılar ({totalPosts})</a>
    </div>
  </section>

  <!-- İLETİŞİM -->
  <section class="block u-reveal">
    <SectionTitle title="İletişim" note="Kısa yazın, net cevap alın." />
    <div style="display:grid;gap:var(--s-6);justify-items:start">
      <a
        href="mailto:ufuksn79@gmail.com"
        class="contact-mail"
        >ufuksn79@gmail.com</a
      >
      <a class="btn btn--primary" href="/iletisim">İletişim sayfası</a>
    </div>
  </section>
</Base>

<style>
  .courses {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .courses { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .courses { grid-template-columns: repeat(3, 1fr); } }

  /* Mobil/tablette videolar parmakla kaydırılan bir şerittir (ADR-020):
     kaydır-bırak, karta yapış. Kaydırma konteynerin içindedir; sayfa
     genişliğini etkilemez. Masaüstünde klasik ızgaraya döner. */
  .vstrip {
    display: grid;
    gap: var(--s-4);
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--s-2);
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }
  .vstrip > .vmini {
    scroll-snap-align: start;
  }
  @media (min-width: 560px) {
    .vstrip { grid-auto-columns: 44%; }
  }
  @media (min-width: 900px) {
    .vstrip {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
  }

  .vmini {
    display: grid;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--c-text);
  }
  .vmini img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-md);
    border: 1px solid var(--c-line);
    transition: opacity var(--d-base) var(--e-out);
  }
  .vmini__title {
    font-size: var(--t-small);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vmini:hover img, .vmini:focus-visible img { opacity: 0.82; }
  .vmini:hover .vmini__title { color: var(--c-accent); }

  /* Bağımsız aksiyon hedefi: 44px altına inmemeli (AGENTS.md §6) */
  .contact-mail {
    font-size: var(--t-h3);
    color: var(--c-accent);
    text-decoration: none;
    word-break: break-word;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .contact-mail:hover,
  .contact-mail:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .about {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: 1.25fr 1fr;
      gap: var(--s-12);
      align-items: start;
    }
  }
</style>
