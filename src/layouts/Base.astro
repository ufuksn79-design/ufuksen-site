---
import "../styles/global.css";
import Rail from "../components/Rail.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string | null;
  /** Kök göreli kanonik yol. Eski URL şeması korunur (ADR-007). */
  path: string;
  ogImage?: string | null;
  type?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
  /** Ana sayfa kart kabuğunu kendi içinde kurar; iç sayfalar dolgu ister. */
  padded?: boolean;
}

const {
  title,
  description = null,
  path,
  ogImage = null,
  type = "website",
  publishedAt,
  modifiedAt,
  jsonLd = null,
  noindex = false,
  padded = true,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.ufuksen.com");
const canonical = new URL(path, site).href;
/** Sayfaya özel görsel yoksa marka görseli kullanılır; her sayfa og:image taşır. */
const VARSAYILAN_OG = "/media/marka/ufuksenlogo.png";
const ogImageUrl = new URL(ogImage ?? VARSAYILAN_OG, site).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#17171b" />

    <meta property="og:site_name" content="Ufuk Şen" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    <link rel="icon" href="/media/marka/favicon-192.jpg" sizes="192x192" />
    <link rel="apple-touch-icon" href="/media/marka/favicon-192.jpg" />

    <link rel="alternate" type="application/rss+xml" title="Ufuk Şen — Blog" href="/rss.xml" />

    <!-- Geist: SIL OFL 1.1, latin + latin-ext (Türkçe doğrulandı — ADR-011) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="u-skip-link" href="#main">İçeriğe atla</a>
    <Rail />

    <div class="app">
      <main id="main" class={padded ? "card card--padded" : "card"}>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      document.documentElement.classList.add("js");

      // Scroll reveal — JS/hareket kapalıyken içerik görünür kalır (ADR-005)
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const reveals = document.querySelectorAll<HTMLElement>(".u-reveal");
      if ("IntersectionObserver" in window && !reduced.matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        reveals.forEach((el, index) => {
          el.style.transitionDelay = `${(index % 4) * 55}ms`;
          io.observe(el);
        });
      } else {
        reveals.forEach((el) => el.classList.add("is-visible"));
      }

      // Okuma ilerlemesi — yalnızca yazı sayfasında bar varsa
      const progress = document.querySelector<HTMLElement>(".progress i");
      const articleBody = document.querySelector<HTMLElement>(".prose");
      if (progress && articleBody) {
        let ticking = false;
        const update = () => {
          const rect = articleBody.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const seen = -rect.top;
          const ratio = total > 0 ? Math.min(1, Math.max(0, seen / total)) : 0;
          progress.style.setProperty("--p", `${(ratio * 100).toFixed(1)}%`);
          ticking = false;
        };
        addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      }

      // İçindekiler: okunan bölümü işaretle
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc a");
      if (tocLinks.length && "IntersectionObserver" in window) {
        const byId = new Map<string, HTMLAnchorElement>();
        tocLinks.forEach((link) => byId.set(decodeURIComponent(link.hash.slice(1)), link));
        const headings = [...byId.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        const ho = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              tocLinks.forEach((link) => link.removeAttribute("aria-current"));
              byId.get(entry.target.id)?.setAttribute("aria-current", "true");
            }
          },
          { rootMargin: "0px 0px -70% 0px" },
        );
        headings.forEach((heading) => ho.observe(heading));
      }

      // Görsel büyütme — render işi için gerekli. Klavye ile kapanır.
      const lightboxRoot = document.querySelector<HTMLElement>("[data-lightbox]");
      if (lightboxRoot) {
        const images = lightboxRoot.querySelectorAll<HTMLImageElement>("img");
        let overlay: HTMLDialogElement | null = null;

        const open = (src: string, alt: string) => {
          if (!overlay) {
            overlay = document.createElement("dialog");
            overlay.className = "lightbox";
            overlay.innerHTML =
              '<button class="lightbox__close" aria-label="Kapat">×</button><img alt="" />';
            document.body.append(overlay);
            overlay.addEventListener("click", (event) => {
              if (event.target === overlay || (event.target as HTMLElement).closest(".lightbox__close")) {
                overlay?.close();
              }
            });
          }
          const target = overlay.querySelector("img")!;
          target.src = src;
          target.alt = alt;
          overlay.showModal();
        };

        images.forEach((image) => {
          if (image.closest("a")) return; // zaten bağlantılıysa dokunma
          image.classList.add("is-zoomable");
          image.tabIndex = 0;
          image.setAttribute("role", "button");
          image.setAttribute("aria-label", `${image.alt || "Görsel"} — büyüt`);
          image.addEventListener("click", () => open(image.currentSrc || image.src, image.alt));
          image.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              open(image.currentSrc || image.src, image.alt);
            }
          });
        });
      }

      // Sayaç animasyonu — yalnızca görünür olduğunda ve hareket izni varken
      const counters = document.querySelectorAll<HTMLElement>("[data-count]");
      if (counters.length && "IntersectionObserver" in window && !reduced.matches) {
        const co = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const target = Number.parseInt(el.dataset.count ?? "0", 10);
              const suffix = el.dataset.suffix ?? "";
              const started = performance.now();
              const duration = 900;
              const tick = (now: number) => {
                const progress = Math.min(1, (now - started) / duration);
                // easeOutCubic
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(target * eased).toLocaleString("tr-TR") + suffix;
                if (progress < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
              co.unobserve(el);
            }
          },
          { threshold: 0.4 },
        );
        counters.forEach((el) => co.observe(el));
      }
    </script>
  </body>
</html>
