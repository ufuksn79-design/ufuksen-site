# FTP erişim bilgileri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# `.env` .gitignore içindedir ve repoya girmez. Parolayı sohbete yazmayın.

FTP_HOST=ftp.ufuksen.com
FTP_USER=usen
FTP_PASSWORD=4251481'ufuk

# Güvenli bağlantı. Sunucu destekliyorsa "true" bırakın (önerilir).
# Düz FTP parolayı ağda açık metin gönderir.
FTP_SECURE=true

# Sunucudaki kök dizin. Genellikle public_html veya www.
FTP_ROOT=/public_html

# Staging alt dizini. Yayına geçmeden önce buraya yüklenir.
# Örn: https://www.ufuksen.com/yeni/
FTP_STAGING_DIR=/public_html/yeni

# Yedeklerin indirileceği yerel klasör
BACKUP_DIR=./backups
